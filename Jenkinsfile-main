pipeline {
  agent any
  tools {
        maven 'MAVEN'
        terraform "terraform-1.12.2"
    }
    environment {
        TF_TOKEN_app_terraform_io = credentials('terraform-cloud')
    }
    parameters {
        string(name: 'RESOURCE_ADDR', defaultValue: '')
    }
    
  stages {
    stage('Checkout') {
      steps {
                git branch: 'dev', url: 'https://github.com/DevOps-Sattibabu/terraform-test-main.git'
      }
    }
    stage('terraform-init') {
        steps {
            bat """
            terraform --version
            REM Configure Terraform Cloud credentials
            mkdir %USERPROFILE%\\.terraform.d
            echo {
                "credentials": {
                    "app.terraform.io": {
                    "token": "%TF_TOKEN_app_terraform_io%"
                    }
                }
            } > %USERPROFILE%\\.terraform.d\\credentials.tfrc.json
            terraform init -no-color
            """
        }
    }
    stage('terraform-state-rm') {
        steps {
          bat """
          terraform state rm ${params.RESOURCE_ADDR}
          """
        }
    }
    stage('terraform-plan') {
        steps {
          bat """
          terraform plan -no-color
          """
        }
    }

  }
}